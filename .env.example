# Copy to .env (git-ignored) and replace the passwords. Never commit real secrets (SEC-02).
# Passwords must meet SQL Server complexity rules (8+ characters, upper, lower, digit, symbol)
# and must not contain ' or ; characters.

# SQL Server sa password: used ONLY by the db-init container to deploy the schema, never by the API (SEC-05).
MSSQL_SA_PASSWORD=ChangeMe_Sa_Str0ng!

# Least-privilege login used by the API: EXECUTE on schema [app] only, no table access.
APP_DB_USER=ship_api
APP_DB_PASSWORD=ChangeMe_App_Str0ng!

DB_NAME=ShipManagement

# 1 = load the fictional sample data and generate random local development API keys
#     (printed once: docker compose logs db-init). Use 0 for any real environment.
SEED_SAMPLE_DATA=1

# 1 = revoke the current development API keys and print new ones on the next deployment
#     (one-off alternative: docker compose run --rm -e ROTATE_DEV_KEYS=1 db-init).
ROTATE_DEV_KEYS=0

# Host ports (bound to 127.0.0.1 only).
API_PORT=8080
SQL_PORT=1433
